rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check auth
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and account info
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // User-specific files and file metadata
      match /files/{fileId} {
        allow read, write: if isOwner(userId);
      }

      // User-specific saved boards or preferences
      match /savedBoards/{boardId} {
        allow read, write: if isOwner(userId);
      }

      // User-specific friends (allow owner or authenticated user adding mutual friendship)
      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || isAuthenticated();
      }
    }

    // Phone index for friend invites and player discovery
    match /phoneIndex/{phoneId} {
      allow read: if true;
      allow write: if true;
    }

    // Referral codes for friend invites and challenge links
    match /referralCodes/{codeId} {
      // Any user (or new registrant) can check a referral code
      allow read: if true;
      // Authenticated users can create or update codes (e.g. mark as used, set reminder)
      allow write: if true;
    }

    // Promotional email subscribers
    match /emailSubscribers/{subscriberId} {
      // Anyone can submit their email subscription for free coins
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 3;
      // Users can view or update verification status of their own subscription
      allow read, update: if true;
    }

    // Multiplayer matchmaking and game rooms
    match /rooms/{roomId} {
      allow read, write: if true;
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Game challenge invites for direct player-to-player challenges
    match /game_invites/{inviteId} {
      allow read, write: if true;
    }

    // Live presence tracking for active online friends and challenge matchmaking
    match /presence/{userId} {
      allow read, write: if true;
    }

    // Multiplayer active lobby pointers
    match /lobbies/{lobbyId} {
      allow read, write: if true;
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Health check and connection validation
    match /test/{docId} {
      allow read: if true;
    }
  }
}
